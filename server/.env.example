# Application Settings
APP_NAME=Content Automation AI
VERSION=1.0.0
DEBUG=True

# Server Settings
HOST=0.0.0.0
PORT=8000

# CORS Settings (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Database Settings - Neon PostgreSQL
# Get your connection string from: https://console.neon.tech/
# Format: postgresql://username:password@ep-xxxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=put-your-database-url-here

# JWT/Auth Settings
SECRET_KEY=your-secret-key-change-this-in-production-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
REPLICATE_API_TOKEN=example_replicate_key
RUNWAY_API_KEY=example_runway_key
RUNWAY_API_URL=
COMFYUI_URL=http://localhost:8188
VIDEO_PROVIDER=replicate

# File Upload Settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
